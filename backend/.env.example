# IGNIS Backend - .env
# Copy this to .env and fill in values as the protocol matures.

PORT=3001
STORE_PATH=./data/ignis-store.json
SESSION_TTL_HOURS=72
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_10_MINUTES=30
REQUEST_BODY_LIMIT=384kb
TRUST_PROXY_HOPS=1
AUTH_SECRET=replace-with-a-long-random-server-secret
AUTH_TOKEN_TTL_MINUTES=30
WALLET_CHALLENGE_TTL_MINUTES=5

# Blind review
# Use three or more unique secrets, each at least 16 characters.
# Format: label:key,label:key,label:key
REVIEW_QUORUM=3
REVIEWER_API_KEYS=reviewer-a:replace-with-a-long-random-key,reviewer-b:replace-with-a-long-random-key,reviewer-c:replace-with-a-long-random-key
# Keep rotated keys here only during a short grace window, then remove them.
REVIEWER_API_KEYS_PREVIOUS=
REVIEWER_TOKEN_TTL_MINUTES=30

# Maintainer publication gate
# Maintainers approve accepted patches before GitHub publication.
MAINTAINER_API_KEYS=maintainer-a:replace-with-a-long-random-key
MAINTAINER_API_KEYS_PREVIOUS=
MAINTAINER_TOKEN_TTL_MINUTES=30

# Adversarial AI review agent
# Never commit a real provider key. Store OPENROUTER_API_KEY only in Railway.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek-v4-flash
OPENROUTER_SITE_URL=https://ignis-protocol.com
OPENROUTER_APP_TITLE=IGNIS
AGENT_API_KEY=replace-with-a-long-random-internal-agent-key
AGENT_TIMEOUT_MS=45000
AGENT_MAX_DIFF_BYTES=60000
AGENT_TEMPERATURE=0.1
AGENT_DRY_RUN=0

# Diff intake
MAX_DIFF_BYTES=262144
MAX_DIFF_LINES=5000
MAX_DIFF_LINE_LENGTH=12000
MAX_ADDED_LINES=2500
SUBMISSION_QUOTA_PER_HOUR=10
SUBMISSION_QUOTA_PER_DAY=30

# Accepted patch publication policy
GITHUB_ALLOWED_REPOSITORIES=ignis-protocol/ignis
PUBLICATION_PROTECTED_PATHS=.github/workflows/**,.env,.env.*,backend/.env*,frontend/.env*,**/*.pem,**/*.key,**/*.p12,**/*.pfx,**/id_rsa,**/id_ed25519,.secrets/**,secrets/**
MAX_PUBLICATION_FILES=25
MAX_PUBLICATION_ADDED_LINES=2500

# Encrypted sealed bundle retention.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation format: key-id:base64-32-byte-key,previous-key-id:base64-32-byte-key
SEALED_BUNDLE_KEYS=2026-01:replace-with-base64-32-byte-key
SEALED_BUNDLE_ACTIVE_KEY_ID=2026-01
BUNDLE_RETENTION_DAYS=30

# Relay transport. Use three independent HTTPS origins in production.
# Each service receives the same node list but should expose only its own infrastructure origin.
# Keep previous secrets in RELAY_NODES_PREVIOUS only during a short rotation grace window.
RELAY_NODES=[{"id":"relay-sea-01","region":"Southeast Asia","role":"ingress","url":"https://relay-sea.example.com","secret":"replace-me"},{"id":"relay-sgp-04","region":"Singapore","role":"mixer","url":"https://relay-sgp.example.com","secret":"replace-me"},{"id":"relay-ams-09","region":"Amsterdam","role":"exit","url":"https://relay-ams.example.com","secret":"replace-me"}]
RELAY_NODES_PREVIOUS=
RELAY_TIMEOUT_MS=5000

# PostgreSQL (Railway Postgres recommended)
DATABASE_URL=
PGSSL=require
PG_POOL_MAX=5

# Solana mainnet proof anchoring.
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_ANCHOR_SECRET_KEY=
ANCHOR_POLL_MS=60000

# GitHub App anonymous PR publishing
# Leave empty to keep maintainer-approved patch export mode only.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_DEFAULT_BASE_BRANCH=main
GITHUB_BOT_NAME=IGNIS
GITHUB_BOT_EMAIL=ignis-protocol[bot]@users.noreply.github.com

# CORS
CORS_ORIGIN=https://ignis-protocol.com,https://www.ignis-protocol.com
