# Ignis Backend — .env
# Copy this to .env and fill in values

PORT=3001

# Base Mainnet RPC
BASE_RPC_URL=https://mainnet.base.org

# bankr.bot Partner Key (preferred)
# Enables no-gas deploys via Token Launch Deploy API with feeRecipient=user wallet.
BANKR_PARTNER_KEY=bk_ptr_your_key_here

# bankr.bot Agent API key (fallback only; may require Bankr Club or LLM credits)
BANKR_API_KEY=bk_your_key_here

# $IGNIS token contract on Base (set after you deploy $IGNIS)
IGNIS_CONTRACT=

# GitlawbBounties.sol contract on Base (read bounties on-chain)
GITLAWB_BOUNTIES_CONTRACT=

# Gitlawb node (default: public)
GITLAWB_NODE=https://node.gitlawb.com

# Minimum $IGNIS to hold for Launch Key
MIN_IGNIS_TO_LAUNCH=1000

# Minimum $IGNIS for Repo Bond
MIN_BOND_IGNIS=100

# Minimum $IGNIS per tip
MIN_TIP_IGNIS=1

# Bond watcher poll interval ms
BOND_POLL_MS=60000

# Basescan API key (optional)
BASESCAN_API_KEY=

# CORS
CORS_ORIGIN=*
